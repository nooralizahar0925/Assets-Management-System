{
  "name": "ams-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:test": "tsx scripts/migrate.ts --test",
    "migrate:prod": "node dist-scripts/migrate.js",
    "build:scripts": "esbuild scripts/migrate.ts scripts/jobs.ts scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-scripts",
    "seed": "tsx scripts/seed.ts",
    "seed:test": "tsx scripts/seed.ts --test",
    "seed:check": "tsx scripts/seed.check.ts",
    "seed:prod": "node dist-scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "jobs": "tsx scripts/jobs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/client-sesv2": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@resvg/resvg-js": "^2.6.2",
    "bwip-js": "^4.11.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "exceljs": "^4.4.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.0",
    "papaparse": "^5.7.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
