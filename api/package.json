{
  "name": "ams-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:test": "tsx scripts/migrate.ts --test",
    "migrate:prod": "node dist-scripts/migrate.js",
    "build:scripts": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-scripts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^15.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
